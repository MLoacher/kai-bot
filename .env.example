# ---------------------------------------------------------------- Claude
# Langlebiger Token aus deinem Claude-Abo. Auf einem Rechner mit Claude Code:
#   claude setup-token
# Gilt ein Jahr. Nie ins Repo, nie in einen Chat.
CLAUDE_CODE_OAUTH_TOKEN=
# Tag, an dem der Token erzeugt wurde (JJJJ-MM-TT). Kai warnt 30 Tage vor Ablauf.
KAI_TOKEN_CREATED=
# Standardmodell fuer alle Chats. Pro Chat ueberschreibbar mit `!kai modell`.
# Leer = claude-opus-5-5 (eingebauter Standard).
KAI_MODEL=claude-opus-5-5
# Modell fuer die einmalige Beschreibung neuer Sticker.
KAI_STICKER_MODEL=sonnet

# ---------------------------------------------------------------- WhatsApp
# Kais eigene Nummer (Zweit-SIM), nur Ziffern mit Laendervorwahl.
# Gesetzt: Kopplung per 8-stelligem Code. Leer: Kopplung per QR-Code.
KAI_PHONE=
# Gruppen-IDs, kommagetrennt. Leer lassen fuer den Einrichtungsmodus:
# Kai listet dann beim Start alle seine Gruppen mit ID im Log auf.
KAI_GROUPS=
# Zusaetzlich freigegebene Direktchats, per Telefonnummer (Ziffern mit Vorwahl,
# kommagetrennt). Das sind NICHT der Besitzer: sie koennen mit Kai schreiben,
# aber keine !kai-Befehle geben. Leer = nur der Besitzer darf direkt schreiben.
KAI_DM_NUMBERS=
# Worauf Kai hoert, zusaetzlich zu @-Erwaehnung und Antworten auf ihn.
KAI_NAMES=Kai

# ---------------------------------------------------------------- Besitzer
# Deine Nummer, nur Ziffern mit Laendervorwahl, z. B. 4915112345678.
# Deine Anweisungen haben Vorrang, und nur du kannst !kai-Befehle geben.
KAI_OWNER_NUMBER=
KAI_OWNER_NAME=Vorname

# ---------------------------------------------------------------- Grenzen
KAI_MAX_RUNS_PER_HOUR=30
# Hoechstens so viele verschickte Nachrichten pro Tag, ueber alle Chats
KAI_MAX_MESSAGES_PER_DAY=300
KAI_MAX_IMAGES_PER_TURN=8
# Nachrichten, die Kai beim Aufwachen mitbekommt (den Rest liest er selbst nach)
KAI_CONTEXT_MESSAGES=10
# Mitreden ohne Ansprache in Gruppen: an/aus, und nach wie viel Sekunden Ruhe Kai die Runde sieht
KAI_PROACTIVE=an
KAI_PROACTIVE_QUIET_SECONDS=8
# Nach FRESH_MINUTES Stille schneller hinschauen, bei lebhaftem Hin und Her langsamer
KAI_PROACTIVE_FRESH_SECONDS=4
KAI_PROACTIVE_FRESH_MINUTES=20
KAI_PROACTIVE_BUSY_SECONDS=15
# Ist Kai gerade im Gespraech (letzte eigene Nachricht juenger als so viele Minuten), schaut er schon nach so vielen Sekunden hin
KAI_FOLLOWUP_MINUTES=10
KAI_FOLLOWUP_SECONDS=3
KAI_MAX_TURNS=20

# ---------------------------------------------------------------- Sprachnachrichten
# Transkription ueber die OpenAI-API. Leer = Kai sagt, dass er sie nicht hoeren kann.
# Das Audio geht dafuer an OpenAI. Schluessel: platform.openai.com > API keys.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Sprachausgabe (sprache_erzeugen) nutzt denselben OPENAI_API_KEY. Modell optional.
KAI_TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------- Videos
# Groessere Videos werden nicht geladen, Kai sieht dann nur das Vorschaubild.
# Den Ton transkribiert derselbe OPENAI_API_KEY wie oben.
KAI_VIDEO_MAX_MB=64

# ---------------------------------------------------------------- Linkschutz
# Eigene Domains, die Kai nie abrufen darf (etwa die deines Homeservers),
# kommagetrennt. Gesperrt ist die Domain und alles darunter. Das Heimnetz
# (private IP-Bereiche) ist ohnehin immer gesperrt.
KAI_BLOCKED_DOMAINS=

# ---------------------------------------------------------------- Stoermeldungen (optional)
# Push aufs Handy per ntfy (https://ntfy.sh oder eigener Server). Leer = die
# Meldungen stehen nur in `docker logs kai`. Ein eigener ntfy-Server muss ueber
# eine OEFFENTLICHE Adresse erreichbar sein: die Firewall sperrt das Heimnetz.
NTFY_URL=
NTFY_TOPIC=kai
NTFY_TOKEN=
